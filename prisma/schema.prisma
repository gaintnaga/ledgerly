// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  USER
}

enum AuthProvider {
  CREDENTIALS
  GOOGLE
}

model User {
  id String @id @default(cuid())
  name String
  email String @unique
  password String?
  provider     AuthProvider  @default(CREDENTIALS)
  googleId     String?       @unique
  profileImage String?

  isActive     Boolean @default(false)

  approvedBy   String?
  approvedAt   DateTime?

  lastLogin    DateTime?  
  
  purchasesPaid  Purchase[] @relation("PaidBy")
  purchasesCreated Purchase[] @relation("CreatedBy")

  purchaseParticipants PurchaseParticipant[]

  role Role @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  approver     User? @relation("UserApprover", fields: [approvedBy], references: [id])
  approvedUsers User[] @relation("UserApprover")
}

model Purchase {
  id String @id @default(cuid())
  title String
  description String?
  totalAmount Decimal @db.Decimal(10,2)
  purchaseDate DateTime @default(now())
  storeName String?
  receiptImage String?

  paidById String
  paidBy User @relation("PaidBy", fields: [paidById], references: [id])

  createdById String
  createdBy User @relation("CreatedBy", fields: [createdById], references: [id])

  participants PurchaseParticipant[]

  items PurchaseItem[]

  createdAt DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model PurchaseParticipant {
  id String @id @default(cuid())
  purchaseId String
  purchase Purchase @relation(fields : [purchaseId], references : [id] , onDelete : Cascade)

  userId String
  user User @relation(fields : [userId] , references : [id])

  shareAmount Decimal @db.Decimal(10,2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PurchaseItem {
  id String @id @default(cuid())
  purchaseId String
  purchase Purchase @relation(fields: [purchaseId], references : [id] , onDelete:Cascade)
  itemName String
  quantity Decimal @db.Decimal(10,2)
  unit String?
  price Decimal @db.Decimal(10,2)
  total Decimal @db.Decimal(10,2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}